<Window x:Class="RogueModeDpsMeter.EncounterComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RogueMode Encounter Comparison"
        Width="1000"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RM.xaml"/>
                <ResourceDictionary Source="Themes/BaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ComparisonComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelStrongBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>

            <Style x:Key="ComparisonSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource HeaderBrandBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="Black"/>
                <Setter Property="Margin" Value="0,0,0,7"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ENCOUNTER COMPARISON"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="Black"/>
                        <TextBlock Text="B VS A · SAVED HISTORY ONLY"
                                   Foreground="{DynamicResource HeaderBrandBrush}"
                                   FontSize="8"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="—"
                                ToolTip="Minimize"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button Content="×"
                                ToolTip="Close"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource HeaderDividerBrush}"/>

            <Grid Grid.Row="2" Margin="10,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="ENCOUNTER A · BASELINE"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="AEncounterComboBox"
                                  Style="{StaticResource ComparisonComboBoxStyle}"
                                  SelectionChanged="EncounterComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Context}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="AEncounterDetailText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="8.5"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Grid.Column="1"
                        Content="⇄"
                        Width="38"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip="Swap encounter A and B"
                        Style="{StaticResource SecondaryParserButtonStyle}"
                        Click="SwapButton_Click"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="ENCOUNTER B · TEST"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="BEncounterComboBox"
                                  Style="{StaticResource ComparisonComboBoxStyle}"
                                  SelectionChanged="EncounterComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Context}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="BEncounterDetailText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="8.5"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="ComparisonWarningBorder"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Margin="10,0,10,6"
                    Background="{DynamicResource ExpanderBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="9,6">
                <TextBlock x:Name="ComparisonWarningText"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="9"
                           TextWrapping="Wrap"/>
            </Border>

            <ScrollViewer Grid.Row="4"
                          Margin="10,0,10,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="SUMMARY"
                                       Style="{StaticResource ComparisonSectionTitleStyle}"/>
                            <Grid Margin="4,0,4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="METRIC" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="A" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="B" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="B VS A" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl x:Name="SummaryRowsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RowChildDividerBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="4,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding BValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Difference}" Foreground="{DynamicResource HeaderBrandBrush}" FontFamily="Consolas" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="CONTRIBUTORS"
                                       Style="{StaticResource ComparisonSectionTitleStyle}"/>
                            <Grid Margin="4,0,4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CONTRIBUTOR" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="A DAMAGE / DPS" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="B DAMAGE / DPS" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="DAMAGE CHANGE" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl x:Name="ContributorComparisonRowsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RowChildDividerBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="4,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="8.5" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding BValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="8.5" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Difference}" Foreground="{DynamicResource HeaderBrandBrush}" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="PAL SKILL ATTRIBUTION"
                                       Style="{StaticResource ComparisonSectionTitleStyle}"/>
                            <Grid Margin="4,0,4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PAL / SKILL" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="A DAMAGE · H · C · AVG/C" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="B DAMAGE · H · C · AVG/C" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="DAMAGE CHANGE" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl x:Name="PalSkillComparisonRowsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RowChildDividerBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="4,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding BValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Difference}" Foreground="{DynamicResource HeaderBrandBrush}" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="EXACT DAMAGE SOURCES"
                                       Style="{StaticResource ComparisonSectionTitleStyle}"/>
                            <Grid Margin="4,0,4,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SOURCE" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="A DAMAGE / HITS" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="B DAMAGE / HITS" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="DAMAGE CHANGE" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl x:Name="DamageSourceComparisonRowsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource RowChildDividerBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="4,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="8.5" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding BValue}" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="8.5" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Difference}" Foreground="{DynamicResource HeaderBrandBrush}" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="5"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderDividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CopyComparisonButton"
                            Content="COPY COMPARISON"
                            Width="128"
                            Style="{StaticResource SecondaryParserButtonStyle}"
                            Click="CopyComparisonButton_Click"/>
                    <TextBlock Grid.Column="1"
                               Text="Differences are calculated as Encounter B minus Encounter A."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="8.5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Content="CLOSE"
                            Width="70"
                            Style="{StaticResource SecondaryParserButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
