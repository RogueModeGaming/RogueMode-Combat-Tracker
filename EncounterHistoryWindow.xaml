<Window x:Class="RogueModeDpsMeter.EncounterHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RogueMode Encounter History"
        Width="920"
        Height="620"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/RM.xaml"/>
                <ResourceDictionary Source="Themes/BaseStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="HistoryListBoxStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <Style x:Key="HistoryTextBoxStyle" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource ExpanderBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}"/>
            </Style>

            <DataTemplate x:Key="HistoryStatCardTemplate">
                <Border Background="{DynamicResource ExpanderBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,6,6"
                        Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="7.5"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Value}"
                                   Foreground="{DynamicResource HeaderBrandBrush}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="7.5"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <Style x:Key="HistoryListItemStyle" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="8,7"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource ButtonHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder"
                                            Property="Background"
                                            Value="{DynamicResource AccentSoftBrush}"/>
                                    <Setter TargetName="ItemBorder"
                                            Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="46"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ENCOUNTER HISTORY"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="Black"/>
                        <TextBlock x:Name="HistoryHeaderCountText"
                                   Text="0 SAVED ENCOUNTERS"
                                   Foreground="{DynamicResource HeaderBrandBrush}"
                                   FontSize="8"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="StatsButton"
                                Content="STATS"
                                Width="64"
                                Margin="0,0,6,0"
                                ToolTip="Show current-session and all-time records"
                                Style="{StaticResource SecondaryParserButtonStyle}"
                                Click="StatsButton_Click"/>
                        <Button x:Name="CompareButton"
                                Content="COMPARE"
                                Width="76"
                                Margin="0,0,6,0"
                                ToolTip="Compare two saved encounters side by side"
                                Style="{StaticResource SecondaryParserButtonStyle}"
                                Click="CompareButton_Click"/>
                        <Button x:Name="ExportSelectedButton"
                                Content="EXPORT ONE"
                                Width="88"
                                Margin="0,0,6,0"
                                ToolTip="Export the selected encounter as CSV or JSON"
                                Style="{StaticResource SecondaryParserButtonStyle}"
                                Click="ExportSelectedButton_Click"/>
                        <Button x:Name="ExportAllButton"
                                Content="EXPORT ALL"
                                Width="82"
                                Margin="0,0,8,0"
                                ToolTip="Export all saved encounters as CSV or JSON"
                                Style="{StaticResource SecondaryParserButtonStyle}"
                                Click="ExportAllButton_Click"/>
                        <Button Content="—"
                                ToolTip="Minimize"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeButton_Click"/>
                        <Button Content="×"
                                ToolTip="Close"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource HeaderDividerBrush}"/>

            <Border x:Name="StatsPanelBorder"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Margin="10,8,10,0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CURRENT SESSION"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <ItemsControl x:Name="SessionStatsControl"
                                      ItemTemplate="{StaticResource HistoryStatCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="1"
                            Background="{DynamicResource HeaderDividerBrush}"
                            HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ALL-TIME RECORDS"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <ItemsControl x:Name="AllTimeStatsControl"
                                      ItemTemplate="{StaticResource HistoryStatCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RECENT ENCOUNTERS"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="SearchResultCountText"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="8"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Row="1"
                                 Style="{StaticResource HistoryTextBoxStyle}"
                                 ToolTip="Search names, targets, notes, or end reasons"
                                 TextChanged="SearchTextBox_TextChanged"
                                 VerticalContentAlignment="Center"/>

                        <ListBox x:Name="EncounterList"
                                 Grid.Row="2"
                                 Margin="0,5,0,0"
                                 Style="{StaticResource HistoryListBoxStyle}"
                                 ItemContainerStyle="{StaticResource HistoryListItemStyle}"
                                 SelectionChanged="EncounterList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PinGlyph}"
                                                       Foreground="{DynamicResource HeaderBrandBrush}"
                                                       FontSize="10"/>
                                            <TextBlock Text="{Binding RecordGlyph}"
                                                       ToolTip="{Binding RecordSummary}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="10"
                                                       Margin="2,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding DisplayTitle}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding ListContextText}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="8.3"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   Text="{Binding DurationText}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="8.3"
                                                   Margin="8,2,0,0"/>
                                        <TextBlock Grid.Row="2"
                                                   Grid.ColumnSpan="2"
                                                   Text="{Binding TeamDpsText}"
                                                   Foreground="{DynamicResource HeaderBrandBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Text="{Binding EndReason}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="7.5"
                                                   HorizontalAlignment="Right"
                                                   Margin="8,4,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <Grid>
                        <TextBlock x:Name="EmptyHistoryText"
                                   Text="No saved encounters yet."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <ScrollViewer x:Name="EncounterDetailScrollViewer"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="DetailTargetText"
                                                   Text="Target"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailOriginalTargetText"
                                                   Text="Original target"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   Margin="0,2,0,0"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="DetailDateText"
                                                   Text="Date"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="9"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="DetailEndReasonText"
                                                   Text="END REASON"
                                                   Foreground="{DynamicResource HeaderBrandBrush}"
                                                   FontSize="8"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <Border x:Name="MetadataEditorBorder"
                                        Visibility="Collapsed"
                                        Margin="0,12,0,0"
                                        Padding="10"
                                        Background="{DynamicResource ExpanderBackgroundBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Text="CUSTOM ENCOUNTER NAME"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="8"
                                                   FontWeight="Bold"/>
                                        <TextBox x:Name="CustomNameTextBox"
                                                 Style="{StaticResource HistoryTextBoxStyle}"
                                                 MaxLength="80"
                                                 Margin="0,5,0,9"/>
                                        <TextBlock Text="NOTES"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="8"
                                                   FontWeight="Bold"/>
                                        <TextBox x:Name="NotesTextBox"
                                                 Style="{StaticResource HistoryTextBoxStyle}"
                                                 MaxLength="1000"
                                                 Height="82"
                                                 Margin="0,5,0,9"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="CANCEL"
                                                    Width="72"
                                                    Style="{StaticResource SecondaryParserButtonStyle}"
                                                    Click="CancelMetadataButton_Click"/>
                                            <Button Content="SAVE"
                                                    Width="72"
                                                    Margin="6,0,0,0"
                                                    Style="{StaticResource PrimaryParserButtonStyle}"
                                                    Click="SaveMetadataButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="4" Margin="0,14,0,14">
                                    <Border Margin="0,0,6,0"
                                            Padding="8"
                                            Background="{DynamicResource ExpanderBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="DURATION"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="7.5"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="DetailDurationText"
                                                       Text="0.0 sec"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0"
                                            Padding="8"
                                            Background="{DynamicResource ExpanderBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="TEAM DPS"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="7.5"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="DetailDpsText"
                                                       Text="0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,0"
                                            Padding="8"
                                            Background="{DynamicResource ExpanderBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL DAMAGE"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="7.5"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="DetailDamageText"
                                                       Text="0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="8"
                                            Background="{DynamicResource ExpanderBackgroundBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="CONTRIBUTORS"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="7.5"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="DetailContributorCountText"
                                                       Text="0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <TextBlock Text="NOTES"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,0,0,5"/>
                                <Border Padding="9"
                                        Background="{DynamicResource ExpanderBackgroundBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <TextBlock x:Name="DetailNotesText"
                                               Text="No notes added."
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="9.5"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="CONTRIBUTORS"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,16,0,5"/>

                                <ItemsControl x:Name="ContributorRowsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="{Binding RowHeight}"
                                                    BorderBrush="{DynamicResource SourceDividerBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="45"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="{Binding NameFontSize}"
                                                               FontWeight="{Binding NameFontWeight}"
                                                               Margin="{Binding NameMargin}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DamageText}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="9.5"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DpsText}"
                                                               Foreground="{DynamicResource HeaderBrandBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding PercentText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="8.5"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="EXACT DAMAGE SOURCES"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,16,0,5"/>

                                <ItemsControl x:Name="DamageSourceRowsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="{Binding RowHeight}"
                                                    BorderBrush="{DynamicResource SourceDividerBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="55"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="{Binding NameFontSize}"
                                                               FontWeight="{Binding NameFontWeight}"
                                                               Margin="{Binding NameMargin}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DamageText}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="9.5"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding PercentText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="8.5"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>


                                <TextBlock Text="PAL SKILL ATTRIBUTION"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="0,16,0,5"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="85"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PAL / SKILL" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="DAMAGE" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="HITS / CASTS" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="AVG / CAST" Foreground="{DynamicResource MutedTextBrush}" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ItemsControl x:Name="PalSkillRowsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="{Binding RowHeight}"
                                                    BorderBrush="{DynamicResource SourceDividerBrush}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="125"/>
                                                        <ColumnDefinition Width="85"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="{Binding NameFontSize}"
                                                               FontWeight="{Binding NameFontWeight}"
                                                               Margin="{Binding NameMargin}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DamageText}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="9.5"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding HitCastText}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="8.5"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding AverageText}"
                                                               Foreground="{DynamicResource HeaderBrandBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderDividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PinEncounterButton"
                            Content="PIN"
                            Width="62"
                            Style="{StaticResource SecondaryParserButtonStyle}"
                            Click="PinEncounterButton_Click"/>
                    <Button x:Name="EditEncounterButton"
                            Grid.Column="1"
                            Content="EDIT"
                            Width="62"
                            Margin="6,0,0,0"
                            Style="{StaticResource SecondaryParserButtonStyle}"
                            Click="EditEncounterButton_Click"/>
                    <Button x:Name="CopySummaryButton"
                            Grid.Column="2"
                            Content="COPY"
                            Width="62"
                            Margin="6,0,0,0"
                            Style="{StaticResource SecondaryParserButtonStyle}"
                            Click="CopySummaryButton_Click"/>
                    <Button x:Name="DeleteEncounterButton"
                            Grid.Column="3"
                            Content="DELETE"
                            Width="68"
                            Margin="6,0,0,0"
                            Style="{StaticResource SecondaryParserButtonStyle}"
                            Click="DeleteEncounterButton_Click"/>
                    <Button x:Name="ClearHistoryButton"
                            Grid.Column="4"
                            Content="CLEAR ALL"
                            Width="78"
                            Margin="6,0,0,0"
                            Style="{StaticResource SecondaryParserButtonStyle}"
                            Click="ClearHistoryButton_Click"/>

                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="PreviousEncounterButton"
                                Content="◀"
                                Width="34"
                                Style="{StaticResource SecondaryParserButtonStyle}"
                                Click="PreviousEncounterButton_Click"/>
                        <TextBlock x:Name="HistoryPositionText"
                                   Text="Encounter 0 of 0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="12,0"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="NextEncounterButton"
                                Content="▶"
                                Width="34"
                                Style="{StaticResource SecondaryParserButtonStyle}"
                                Click="NextEncounterButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
